# Copy to `.env.local` for local development.
# Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# ── Required ──────────────────────────────────────────────
MONGODB_URI=

# Signed admin sessions (min 32 characters) — required in production
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── First admin only (when the Admin collection is empty) ─
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional ─────────────────────────────────────────────
# Contact form email (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# IP rate limiting — Vercel KV / Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
