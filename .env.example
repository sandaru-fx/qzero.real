# Copy to `.env.local` for local dev / set in Vercel for production.
# Never commit real secrets.

# MongoDB
MONGODB_URI=

# Admin bootstrap (only used when zero admins exist in DB)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signed admin sessions — required in production (min 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email (contact form)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Vercel KV / Upstash Redis — IP rate limiting (admin login + public forms)
# From Vercel Storage → Redis/KV, or Upstash console REST credentials.
# Either KV_* or UPSTASH_* works (code aliases UPSTASH → KV when needed).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
